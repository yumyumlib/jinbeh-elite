# Dependencies
node_modules
npm-debug.log

# Build output
.next
out

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Git
.git
.gitignore

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# Environment
.env*
!.env.example

# Testing
coverage
.nyc_output

# Misc
README.md
*.md

# Root-level research/report/media artifacts are not needed for the Next build.
/*.docx
/*.pdf
/*.pages
/*.xlsx
/*.xls
/*.csv
/*.jpeg
/*.jpg
/*.png
/*.webp
/MASTER_DOCS
/Menu_Media
/outputs
/progress-report*.html
/progress-report*.md

# Archived / retired content (root-only perms; not for the image or serving)
.archived
public/.archived
**/.archived

# Build/scratch helpers that should never ship in the image
_genresp.js

# Unreferenced image originals & backups — NOT served by the site, but they
# bloat the Docker build context (~441 MB) and are a primary cause of slow /
# stuck deploys. They remain on disk for re-processing; just don't ship them.
public/images/catalog-originals
public/images/*.tar.gz
public/images/*.tar
